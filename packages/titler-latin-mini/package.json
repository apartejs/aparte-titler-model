  },
  "bugs": "https://github.com/apartejs/aparte-titler-model/issues",
  "keywords": [
    "chat",
    "title",
    "conversation",
    "extractive",
    "tiny-model",
    "browser",
    "offline",
    "aparte",
    "nlp",
    "multilingual",
    "european-languages",
    "lightweight",
    "small"
  ],
  "type": "module",
  "main": "./src/index.js",
